{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm install && vite build",
        "build_app": "npm install && composer install && php artisan migrate:fresh && php artisan key:generate && php artisan db:seed",
        "dev": "vite",
        "app": "concurrently \"npm run dev\" \"php artisan reverb:start\" \"php artisan serve\" \"php artisan mqtt:listen\"",
        "database": "php artisan migrate:fresh && php artisan migrate --pretend"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.2.4",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "daisyui": "^5.5.19",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.0.0",
        "postcss": "^8.4.31",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^4.2.4",
        "vite": "^8.0.10"
    },
    "dependencies": {
        "axios": "^1.16.0",
        "pixi-live2d-display": "^0.4.0",
        "pixi.js": "^6.5.2"
    }
}
